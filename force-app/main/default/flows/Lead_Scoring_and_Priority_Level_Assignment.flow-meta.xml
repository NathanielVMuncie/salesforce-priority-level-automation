            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Upscale Restaurant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Upscale_Restaurant_Add_3_Points</targetReference>
            </connector>
            <label>Is Upscale Restaurant</label>
        </rules>
        <rules>
            <name>Is_Specialty_Gourmet_Grocer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Specialty Gourmet Grocer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Specialty_Gourmet_Grocer_Add_2_Points</targetReference>
            </connector>
            <label>Is Specialty Gourmet Grocer</label>
