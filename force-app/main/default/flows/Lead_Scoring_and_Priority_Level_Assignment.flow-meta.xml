    <decisions>
        <description>Calculates the final Priority Level (High, Medium, or Low) based on the cumulative Lead Score derived from business type, role, and purchasing timeline. This decision determines downstream routing, escalation, and queue assignment behavior.</description>
        <name>Determine_Priority_Level</name>
        <label>Determine Priority Level</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Priority_Level_Low</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ia Priority Level Low</defaultConnectorLabel>
        <rules>
            <name>Is_Priority_Level_High</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>12.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Priority_Level_High</targetReference>
            </connector>
            <label>Is Priority Level  High</label>
        </rules>
        <rules>
            <name>Ia_Priority_Level_Medium</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalScore</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>8.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Priority_Level_Medium</targetReference>
            </connector>
            <label>Ia Priority Level Medium</label>
        </rules>
    </decisions>
