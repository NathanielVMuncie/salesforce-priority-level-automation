    <decisions>
        <description>Evaluates the Lead’s declared business type and assigns a weighted score based on strategic value and expected revenue potential. Higher-value commercial buyers receive more points, while non-business or consumer leads are routed to disqualification logic.</description>
        <name>Determine_Business_Type_Score</name>
        <label>Determine Business Type Score</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Business_Type_Queue_Routing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Business Type Queue Routing</defaultConnectorLabel>
        <rules>
            <name>Is_Premium_Wine_Distributor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Premium Wine Distributor</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Premium_Wine_Distributor_Add_5_Points</targetReference>
            </connector>
            <label>Is Premium Wine Distributor</label>
        </rules>
        <rules>
            <name>Is_High_End_Wine_Store</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High-End Wine Store</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>High_End_Wine_Store_Add_4_Points</targetReference>
            </connector>
